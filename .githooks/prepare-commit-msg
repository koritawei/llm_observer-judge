#!/usr/bin/env bash
# Strip Cursor-injected Co-authored-by trailers from commit messages.
MSG_FILE="${1:?}"
if [[ ! -f "$MSG_FILE" ]]; then
  exit 0
fi
tmp="$(mktemp)"
grep -viE '^Co-authored-by:[[:space:]]*Cursor[[:space:]]*<' "$MSG_FILE" >"$tmp" || true
# Remove trailing blank lines left after stripping trailers
sed -i '' -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" 2>/dev/null || sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp"
mv "$tmp" "$MSG_FILE"
exit 0
