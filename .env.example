# Copy to `.env` and fill in secrets. `.env` is gitignored.
# Compose 与本地进程均从此文件读取；Docker 网络内主机名见 *_COMPOSE 变量。

# =============================================================================
# Gateway / SDK
# =============================================================================
LLMJUDGE_API_KEYS=dev-key:tenant-dev
# LLMJUDGE_API_KEY=          # SDK 客户端（单 key）
# LLMJUDGE_ENDPOINT=http://127.0.0.1:8080

# =============================================================================
# Postgres（账号 + 本地连接串）
# =============================================================================
POSTGRES_USER=llmj
POSTGRES_PASSWORD=llmj
POSTGRES_DB=llmjudge
POSTGRES_PORT=5432

# 本机连 Docker 映射端口（llmj-stack / llmj-db / pytest）
LLMJUDGE_DATABASE_URL=postgresql+asyncpg://llmj:llmj@127.0.0.1:5432/llmjudge
# Compose 容器内（hostname=postgres）
LLMJUDGE_DATABASE_URL_COMPOSE=postgresql+asyncpg://llmj:llmj@postgres:5432/llmjudge

# 本机默认 memory；Compose 用 sql（见 LLMJUDGE_PERSISTENCE_COMPOSE）
LLMJUDGE_PERSISTENCE=memory
LLMJUDGE_PERSISTENCE_COMPOSE=sql
LLMJUDGE_SCHEMA_MODE=alembic
# LLMJUDGE_ALEMBIC_INI=

# =============================================================================
# Redis
# =============================================================================
REDIS_PORT=6379
# 本机
LLMJUDGE_REDIS_URL=redis://127.0.0.1:6379/0
# Compose 容器内
LLMJUDGE_REDIS_URL_COMPOSE=redis://redis:6379/0
# 可选：带密码
# LLMJUDGE_REDIS_URL=redis://:password@127.0.0.1:6379/0
# LLMJUDGE_REDIS_URL_COMPOSE=redis://:password@redis:6379/0

# =============================================================================
# 消息中间件（MQ）
# memory | redis | rocketmq（rocketmq 尚未实现）
# =============================================================================
LLMJUDGE_MQ=memory
# Compose split 多进程默认 redis
LLMJUDGE_MQ_COMPOSE=redis
LLMJUDGE_MQ_GROUP=llmj
# LLMJUDGE_MQ_CONSUMER=
LLMJUDGE_DISPATCH_CONFIG=configs/dispatch.yaml
LLMJUDGE_DISPATCH_CONFIG_COMPOSE=/app/configs/dispatch.yaml

# =============================================================================
# 运行时
# =============================================================================
LLMJUDGE_FORCE_SAMPLE=1
LLMJUDGE_POLL_INTERVAL=0.05
LLMJUDGE_HOST=0.0.0.0
LLMJUDGE_PORT=8080
LLMJUDGE_LOG_LEVEL=INFO

# =============================================================================
# HTTP / DeepSeek Judge（OpenAI-compatible）
# =============================================================================
LLMJUDGE_JUDGE_BASE_URL=https://api.deepseek.com
LLMJUDGE_JUDGE_API_KEY=sk-your-deepseek-key
LLMJUDGE_JUDGE_MODEL_NAME=deepseek-v4-flash
LLMJUDGE_JUDGE_MODEL_ID=http-judge
LLMJUDGE_JUDGE_TIMEOUT=90
# Local transparent proxies may map public hosts to 198.18.0.0/15
LLMJUDGE_JUDGE_ENFORCE_SSRF=0

# Optional aliases → LLMJUDGE_JUDGE_*（未设置正式变量时生效）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Attribution ReAct（未设时回落 JUDGE_*）
# LLMJUDGE_REACT_BASE_URL=
# LLMJUDGE_REACT_API_KEY=
# LLMJUDGE_REACT_MODEL_NAME=
# LLMJUDGE_REACT_ENFORCE_SSRF=
